# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required for TanStack Start server auth)
CLERK_SECRET_KEY=
# Clerk Frontend API URL used by Convex to validate Clerk JWTs
CLERK_JWT_ISSUER_DOMAIN=

# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# Daytona (Convex dashboard only — not Vite client env)
# Set these in the Convex dashboard for sandbox provisioning actions:
# DAYTONA_API_KEY=        # from https://app.daytona.io/
# DAYTONA_TARGET=          # optional region, e.g. us
# CLERK_SECRET_KEY=         # same value as above; used to fetch GitHub clone tokens in actions
