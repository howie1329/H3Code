{
  "name": "@h3code/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n renderer,electron -c blue,green \"vite dev --host 127.0.0.1 --port 5173\" \"wait-on tcp:5173 && electron .\"",
