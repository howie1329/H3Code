{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "CONVEX_DEPLOYMENT",
        "VITE_CLERK_PUBLISHABLE_KEY",
        "VITE_CONVEX_SITE_URL",
        "VITE_CONVEX_URL"
      ],
      "outputs": [
        ".svelte-kit/**",
        ".vercel/output/**",
        ".output/**",
        "build/**",
        "dist/**"
      ]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
